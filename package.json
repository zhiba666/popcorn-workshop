{
  "name": "popcorn-workshop",
  "version": "0.0.0",
  "private": true,
  "description": "Douyin mini-game and local development previews",
  "os": ["win32"],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build:content": "node tools/content/build-customer-content.cjs",
    "check:content": "node tools/content/build-customer-content.cjs --check",
    "build:assets": "node tools/assets/build-game-assets.cjs",
    "build:assets:scene": "node tools/assets/build-game-assets.cjs --factory-scene-only",
    "check:assets": "node tools/assets/build-game-assets.cjs --check",
    "preview": "node tools/preview/serve-previews.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
